<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<meta name="theme-color" content="#1c1e20">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="GH Speed">
<title>GH Speed Alert</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet">
<style>
:root{
  --asphalt:#1c1e20; --line:#f2c230; --sign:#d7261e; --paper:#f6f6f2;
  --ink:#14161a; --muted:#6b7280; --card:rgba(255,255,255,.84); --chip:#e8eaee; --track:rgba(20,22,26,.12);
  --display:"Barlow Condensed","Arial Narrow",Arial,sans-serif;
  --body:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
}
@media (prefers-color-scheme:dark){
  :root{--ink:#f5f6f7;--muted:#a0a6ad;--card:rgba(24,26,29,.84);--chip:#2d3136;--track:rgba(255,255,255,.14)}
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;margin:0;background:var(--asphalt);color:var(--ink);font-family:var(--body);
  overflow:hidden;overscroll-behavior:none;touch-action:manipulation;-webkit-user-select:none;user-select:none}
button{font:inherit;color:inherit;cursor:pointer;border:0}
button:focus-visible{outline:3px solid var(--line);outline-offset:2px}

/* Welcome screen */
#splash{position:fixed;inset:0;z-index:3000;display:flex;flex-direction:column;justify-content:space-between;color:var(--paper);
  padding:calc(env(safe-area-inset-top,0px) + 28px) 24px calc(env(safe-area-inset-bottom,0px) + 24px);
  background:radial-gradient(120% 70% at 50% 0%,#33373b 0%,var(--asphalt) 60%);transition:opacity .4s,visibility .4s}
#splash.hide{opacity:0;visibility:hidden}
.road{position:absolute;left:50%;top:0;bottom:0;width:6px;transform:translateX(-50%);
  background:repeating-linear-gradient(to bottom,var(--line) 0 38px,transparent 38px 76px);opacity:.16}
.hero{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;margin-top:6vh}
.sign{width:min(58vw,240px);aspect-ratio:1;border-radius:50%;background:var(--paper);border:min(8.5vw,32px) solid var(--sign);
  display:flex;align-items:center;justify-content:center;font-family:var(--display);font-weight:700;color:#111;
  font-size:min(30vw,116px);line-height:1;box-shadow:0 0 0 6px var(--asphalt),0 0 0 9px var(--paper),0 24px 60px rgba(0,0,0,.5)}
.hero h1{font-family:var(--display);font-weight:700;font-size:clamp(46px,15vw,66px);line-height:1;margin:34px 0 10px}
.hero p{margin:0;max-width:30ch;color:#aeb3b9;font-size:17px;line-height:1.45}
.foot{position:relative;display:flex;flex-direction:column;gap:12px}
.go{width:100%;padding:18px;border-radius:16px;background:var(--line);color:#1a1a1a;
  font-family:var(--display);font-weight:700;font-size:27px;letter-spacing:.02em;box-shadow:0 10px 30px rgba(242,194,48,.25)}
.go:active{transform:scale(.98)}
.ghost{width:100%;padding:14px;border-radius:14px;background:rgba(255,255,255,.1);color:var(--paper);font-size:16px;font-weight:600}
.ghost[hidden],.note[hidden]{display:none}
.note{margin:0;text-align:center;color:#aeb3b9;font-size:13.5px;line-height:1.45}

/* Map */
#map{position:fixed;inset:0;background:#cfd4d8}
.leaflet-container{font-family:var(--body)}
.leaflet-control-attribution{font-size:10px}
.me{width:22px;height:22px;border-radius:50%;background:#1a73e8;border:4px solid #fff;box-shadow:0 0 0 2px rgba(26,115,232,.35),0 2px 8px rgba(0,0,0,.4)}

#banner{position:fixed;left:12px;right:12px;top:calc(env(safe-area-inset-top,0px) + 10px);z-index:1500;
  padding:14px 16px;border-radius:16px;background:var(--card);color:var(--ink);font-size:16px;line-height:1.35;font-weight:600;
  -webkit-backdrop-filter:blur(16px) saturate(1.4);backdrop-filter:blur(16px) saturate(1.4);box-shadow:0 8px 28px rgba(0,0,0,.25)}
#banner.warn{background:var(--sign);color:#fff;font-family:var(--display);font-weight:700;font-size:30px;text-align:center;letter-spacing:.02em}
#banner[hidden]{display:none}

/* Bottom sheet */
#hud{position:fixed;left:0;right:0;bottom:0;z-index:1500;color:var(--ink);background:var(--card);
  padding:10px 18px calc(env(safe-area-inset-bottom,0px) + 14px);border-radius:26px 26px 0 0;
  -webkit-backdrop-filter:blur(18px) saturate(1.5);backdrop-filter:blur(18px) saturate(1.5);
  box-shadow:0 -10px 34px rgba(0,0,0,.25);transition:background .2s,color .2s}
#hud.over{background:rgba(215,38,30,.94);color:#fff;--muted:#ffd9d6;--chip:rgba(0,0,0,.25);--track:rgba(255,255,255,.28)}
.grip{width:38px;height:5px;border-radius:3px;background:var(--track);margin:0 auto 12px}
.main{display:flex;align-items:center;justify-content:space-between;gap:14px}
.gauge{position:relative;width:150px;height:150px;flex:none}
.gauge svg{width:100%;height:100%;transform:rotate(-90deg)}
.gauge circle{fill:none;stroke-width:11;stroke-linecap:round}
.gauge .bg{stroke:var(--track)}
.ring{stroke-dasharray:351.86;stroke-dashoffset:351.86;transition:stroke-dashoffset .35s ease,stroke .2s}
.ring.ok{stroke:#27ae60}.ring.warn{stroke:#f2b600}.ring.over{stroke:#fff}
.gauge .c{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
#spd{font-family:var(--display);font-weight:700;font-size:70px;line-height:.9;font-variant-numeric:tabular-nums}
.unit{font-family:var(--display);font-weight:600;font-size:20px;color:var(--muted);margin-top:2px}
.side{display:flex;flex-direction:column;align-items:center;gap:12px;flex:1}
.limit{width:96px;height:96px;border-radius:50%;background:var(--paper);border:9px solid var(--sign);color:#111;
  font-family:var(--display);font-weight:700;font-size:42px;line-height:1;padding:0;display:flex;align-items:center;justify-content:center;
  box-shadow:0 6px 16px rgba(0,0,0,.2)}
#hud.over .limit{border-color:var(--paper);box-shadow:0 0 0 3px rgba(255,255,255,.5)}
.limit:active{transform:scale(.96)}
.hint{font-size:12.5px;color:var(--muted);margin:0}
.stats{display:flex;gap:18px;margin-top:12px;padding-top:12px;border-top:1px solid var(--track)}
.stat{flex:1}
.stat b{display:block;font-family:var(--display);font-size:26px;font-weight:700;line-height:1}
.stat span{font-size:12.5px;color:var(--muted)}
#presets{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
#presets[hidden]{display:none}
.chip{padding:9px 16px;border-radius:999px;background:var(--chip);font-family:var(--display);font-weight:600;font-size:22px}
.chip.on{background:var(--ink);color:var(--paper)}
@media (prefers-color-scheme:dark){.chip.on{color:#111}}
#hud.over .chip.on{background:#fff;color:#111}
#status{margin:10px 0 0;font-size:13.5px;color:var(--muted);line-height:1.4}
.tools{display:flex;gap:8px;margin-top:10px}
.tool{flex:1;padding:12px;border-radius:14px;background:var(--chip);font-size:15px;font-weight:600}
.tool[hidden]{display:none}
@media (max-height:640px){.gauge{width:124px;height:124px}#spd{font-size:56px}.limit{width:80px;height:80px;font-size:34px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>

<section id="splash">
  <div class="road" aria-hidden="true"></div>
  <div class="hero">
    <div class="sign" aria-hidden="true">50</div>
    <h1>GH Speed Alert</h1>
    <p>See your speed on a live map and get a warning the moment you go over the limit.</p>
  </div>
  <div class="foot">
    <button class="go" id="startBtn" type="button">Start driving</button>
    <button class="ghost" id="installBtn" type="button" hidden>Install app</button>
    <p class="note" id="installNote"></p>
    <p class="note">Tap Allow when your phone asks for your location.</p>
  </div>
</section>

<div id="map"></div>
<div id="banner" hidden></div>

<section id="hud" aria-live="polite">
  <div class="grip"></div>
  <div class="main">
    <div class="gauge">
      <svg viewBox="0 0 130 130" aria-hidden="true">
        <circle class="bg" cx="65" cy="65" r="56"></circle>
        <circle class="ring ok" id="ring" cx="65" cy="65" r="56"></circle>
      </svg>
      <div class="c"><span id="spd">0</span><span class="unit">km/h</span></div>
    </div>
    <div class="side">
      <button class="limit" id="limitBtn" type="button" aria-label="Speed limit. Tap to change.">50</button>
      <p class="hint">Tap to change limit</p>
    </div>
  </div>
  <div id="presets" hidden></div>
  <div class="stats">
    <div class="stat"><b id="max">0</b><span>Top speed, km/h</span></div>
    <div class="stat"><b id="trip">0.0</b><span>Trip, km</span></div>
  </div>
  <p id="status">Waiting for GPS signal…</p>
  <div class="tools">
    <button class="tool" id="recenter" type="button" hidden>Follow me</button>
    <button class="tool" id="testBtn" type="button">Test sounds</button>
    <button class="tool" id="muteBtn" type="button">Sound on</button>
  </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
(function(){
  var $ = function(id){ return document.getElementById(id); };

  // Speed limit zones. Add your own, for example:
  // { name: "Ring Road Central", lat: 5.5600, lng: -0.2100, r: 300, limit: 50 }
  var ZONES = [];
  var PRESETS = [30, 40, 50, 60, 80, 100];
  var limit = 50, map, meMarker, accCircle, followMe = true, firstFix = true;
  var muted = false, audio, lastBeep = 0, lastVoice = 0, lastSoft = 0, last = null, trip = 0, maxSpd = 0, wake = null;

  /* ---------- Install as an app (iPhone and Android) ---------- */
  function makeIcon(s){
    var c = document.createElement('canvas'); c.width = c.height = s;
    var x = c.getContext('2d');
    x.fillStyle = '#1c1e20'; x.fillRect(0, 0, s, s);
    x.beginPath(); x.arc(s/2, s/2, s*.34, 0, 7); x.fillStyle = '#d7261e'; x.fill();
    x.beginPath(); x.arc(s/2, s/2, s*.25, 0, 7); x.fillStyle = '#f6f6f2'; x.fill();
    x.fillStyle = '#111'; x.font = 'bold ' + (s*.26) + 'px Arial'; x.textAlign = 'center'; x.textBaseline = 'middle';
    x.fillText('GH', s/2, s/2 + s*.01);
    return c.toDataURL('image/png');
  }
  try {
    var a = document.createElement('link'); a.rel = 'apple-touch-icon'; a.href = makeIcon(180); document.head.appendChild(a);
    var manifest = {
      name: 'GH Speed Alert', short_name: 'GH Speed',
      start_url: location.href.split('#')[0].split('?')[0],
      display: 'standalone', background_color: '#1c1e20', theme_color: '#1c1e20',
      icons: [
        { src: makeIcon(192), sizes: '192x192', type: 'image/png', purpose: 'any maskable' },
        { src: makeIcon(512), sizes: '512x512', type: 'image/png', purpose: 'any maskable' }
      ]
    };
    var m = document.createElement('link'); m.rel = 'manifest';
    m.href = URL.createObjectURL(new Blob([JSON.stringify(manifest)], { type: 'application/manifest+json' }));
    document.head.appendChild(m);
  } catch(e){}

  var iOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  var standalone = (window.matchMedia && matchMedia('(display-mode: standalone)').matches) || navigator.standalone;
  var deferred = null;
  if (standalone) { $('installNote').hidden = true; }
  else if (iOS) { $('installNote').textContent = 'To install: tap the Share button in Safari, then Add to Home Screen.'; }
  else { $('installNote').textContent = 'To install: open the browser menu and tap Install app or Add to Home screen.'; }
  window.addEventListener('beforeinstallprompt', function(e){
    e.preventDefault(); deferred = e;
    $('installBtn').hidden = false; $('installNote').hidden = true;
  });
  $('installBtn').onclick = function(){
    if (!deferred) return;
    deferred.prompt();
    deferred.userChoice.then(function(){ deferred = null; $('installBtn').hidden = true; });
  };

  /* ---------- Limit and controls ---------- */
  PRESETS.forEach(function(v){
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'chip'; b.textContent = v; b.dataset.v = v;
    b.onclick = function(){ setLimit(v); $('presets').hidden = true; };
    $('presets').appendChild(b);
  });
  function setLimit(v){
    limit = v; $('limitBtn').textContent = v;
    Array.prototype.forEach.call($('presets').children, function(c){ c.classList.toggle('on', +c.dataset.v === v); });
  }
  setLimit(50);
  $('limitBtn').onclick = function(){ $('presets').hidden = !$('presets').hidden; };
  $('muteBtn').onclick = function(){ muted = !muted; $('muteBtn').textContent = muted ? 'Sound off' : 'Sound on'; };
  $('testBtn').onclick = function(){
    if (audio && audio.resume) audio.resume();
    softChime();
    setTimeout(loudAlarm, 1400);
  };
  $('recenter').onclick = function(){
    followMe = true; $('recenter').hidden = true;
    if (meMarker) map.setView(meMarker.getLatLng(), Math.max(map.getZoom(), 16));
  };
  function status(t){ $('status').textContent = t; }

  /* ---------- Map ---------- */
  function initMap(){
    map = L.map('map', { zoomControl: false }).setView([5.6037, -0.1870], 13);
    var dark = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches;
    if (dark) {
      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        subdomains: 'abcd', maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors &copy; CARTO'
      }).addTo(map);
    } else {
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19, attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);
    }
    map.on('dragstart', function(){ followMe = false; $('recenter').hidden = false; });
    ZONES.forEach(function(z){
      L.circle([z.lat, z.lng], { radius: z.r, color: '#d7261e', weight: 2, fillOpacity: .08 })
        .addTo(map).bindTooltip(z.name + ': ' + z.limit + ' km/h');
    });
  }

  /* ---------- Alerts ---------- */
  function tone(freq, start, dur, vol, type){
    var o = audio.createOscillator(), g = audio.createGain(), t = audio.currentTime + start;
    o.type = type || 'sine'; o.frequency.value = freq;
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(vol, t + 0.02);
    g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    o.connect(g); g.connect(audio.destination);
    o.start(t); o.stop(t + dur + 0.05);
  }
  // Gentle two-note chime: you are close to the limit
  function softChime(){
    if (muted || !audio) return;
    try { tone(660, 0, .35, .3); tone(880, .18, .5, .3); } catch(e){}
    if (navigator.vibrate) navigator.vibrate(100);
  }
  // Loud triple alarm: you have reached or passed the limit
  function loudAlarm(){
    if (muted || !audio) return;
    try { for (var i = 0; i < 3; i++) tone(1000, i * .28, .2, .9, 'square'); } catch(e){}
    if (navigator.vibrate) navigator.vibrate([200, 100, 200, 100, 200]);
  }
  function speakSlowDown(){
    var now = Date.now();
    if (muted || now - lastVoice < 8000 || !window.speechSynthesis) return;
    lastVoice = now;
    try { speechSynthesis.speak(new SpeechSynthesisUtterance('Slow down')); } catch(e){}
  }

  /* ---------- GPS ---------- */
  function onPos(p){
    var c = p.coords, ll = [c.latitude, c.longitude];
    var kmh = (c.speed != null && !isNaN(c.speed)) ? Math.round(c.speed * 3.6) : 0;

    if (!meMarker) {
      meMarker = L.marker(ll, { icon: L.divIcon({ className: '', html: '<div class="me"></div>', iconSize: [22,22], iconAnchor: [11,11] }) }).addTo(map);
      accCircle = L.circle(ll, { radius: c.accuracy, color: '#1a73e8', weight: 1, fillOpacity: .1 }).addTo(map);
    } else {
      meMarker.setLatLng(ll); accCircle.setLatLng(ll).setRadius(c.accuracy);
    }
    if (firstFix) { map.setView(ll, 16); firstFix = false; }
    else if (followMe) { map.panTo(ll, { animate: true }); }

    if (last && c.accuracy < 40) {
      var d = map.distance(last, ll);
      if (d > 4 && d < 500) trip += d;
    }
    last = ll;
    if (kmh > maxSpd) maxSpd = kmh;

    var inZone = null;
    for (var i = 0; i < ZONES.length; i++) {
      if (map.distance(ll, [ZONES[i].lat, ZONES[i].lng]) <= ZONES[i].r) { inZone = ZONES[i]; break; }
    }
    if (inZone && limit !== inZone.limit) setLimit(inZone.limit);

    var over = kmh >= limit;
    var near = !over && kmh >= limit - Math.max(3, Math.round(limit * .1));
    $('spd').textContent = kmh;
    $('max').textContent = maxSpd;
    $('trip').textContent = (trip / 1000).toFixed(1);
    $('hud').classList.toggle('over', over);
    var ring = $('ring');
    ring.style.strokeDashoffset = 351.86 * (1 - Math.min(kmh / (limit * 1.25), 1));
    ring.setAttribute('class', 'ring ' + (over ? 'over' : near ? 'warn' : 'ok'));

    var b = $('banner');
    var now = Date.now();
    if (over) {
      b.hidden = false; b.className = 'warn';
      b.textContent = kmh > limit ? 'Slow down. Limit is ' + limit + ' km/h' : 'At the limit: ' + limit + ' km/h';
      lastSoft = now;
      if (now - lastBeep > 2500) { lastBeep = now; loudAlarm(); }
      if (kmh > limit) speakSlowDown();
    } else if (near) {
      b.hidden = false; b.className = '';
      b.textContent = 'Close to the limit: ' + limit + ' km/h';
      if (now - lastSoft > 12000) { lastSoft = now; softChime(); }
    } else if (inZone) {
      b.hidden = false; b.className = '';
      b.textContent = inZone.name + ': limit ' + inZone.limit + ' km/h';
    } else { b.hidden = true; }
    if (!near && !over) lastSoft = 0;
    status('GPS accuracy about ' + Math.round(c.accuracy) + ' m');
  }
  function onErr(e){
    if (e.code === 1) status('Location is blocked. Allow location for this site in your browser settings, then reload.');
    else if (e.code === 2) status('No GPS signal. Move to an open area and wait a moment.');
    else status('GPS is taking too long. Check that location is turned on.');
  }

  function keepAwake(){
    try {
      if (navigator.wakeLock) navigator.wakeLock.request('screen').then(function(w){ wake = w; }).catch(function(){});
    } catch(e){}
  }
  document.addEventListener('visibilitychange', function(){ if (document.visibilityState === 'visible' && map) keepAwake(); });

  $('startBtn').onclick = function(){
    $('splash').classList.add('hide');
    initMap();
    try { audio = new (window.AudioContext || window.webkitAudioContext)(); if (audio.resume) audio.resume(); } catch(e){}
    try { if (window.speechSynthesis) speechSynthesis.speak(new SpeechSynthesisUtterance('')); } catch(e){}
    keepAwake();
    if (!navigator.geolocation) { status('This browser cannot read GPS.'); return; }
    navigator.geolocation.watchPosition(onPos, onErr, { enableHighAccuracy: true, maximumAge: 1000, timeout: 20000 });
  };
})();
</script>
</body>
</html>
